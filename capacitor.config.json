{
  "appId": "es.gbhnutricion.app",
  "appName": "GBH Nutrición",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "iosScheme": "capacitor"
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#081208",
    "webContentsDebuggingEnabled": false
  },
  "ios": {
    "contentInset": "always",
    "backgroundColor": "#081208",
    "preferredContentMode": "mobile"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1000,
      "launchAutoHide": true,
      "backgroundColor": "#081208FF",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#081208",
      "overlaysWebView": false
    }
  }
}
